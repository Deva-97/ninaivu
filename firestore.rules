rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{businessId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isSelf(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function userDoc() {
        return get(/databases/$(database)/documents/businesses/$(businessId)/users/$(request.auth.uid));
      }

      function userDocExists() {
        return exists(/databases/$(database)/documents/businesses/$(businessId)/users/$(request.auth.uid));
      }

      function isActiveUser() {
        return isSignedIn()
          && userDocExists()
          && userDoc().data.isDeleted != true
          && userDoc().data.status == 'active';
      }

      function isAdmin() {
        return isActiveUser() && userDoc().data.role == 'admin';
      }

      function isAgent() {
        return isActiveUser() && userDoc().data.role == 'agent';
      }

      function isScopedWrite() {
        return request.resource.data.businessId == businessId;
      }

      function isScopedUserWrite(userId) {
        return isScopedWrite()
          && request.resource.data.id == userId;
      }

      function ownsRecord() {
        return request.resource.data.createdBy == request.auth.uid
          || request.resource.data.agentId == request.auth.uid
          || request.resource.data.assignedTo == request.auth.uid;
      }

      function ownsExistingRecord() {
        return resource.data.createdBy == request.auth.uid
          || resource.data.agentId == request.auth.uid
          || resource.data.assignedTo == request.auth.uid;
      }

      allow read: if isAdmin();

      match /users/{userId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create, update: if isAdmin()
          || (isSelf(userId)
            && isScopedUserWrite(userId)
            && request.resource.data.role in ['admin', 'agent']
            && request.resource.data.isDeleted != true
            && request.resource.data.status == 'active');
        allow delete: if isAdmin();
      }

      match /clients/{clientId} {
        allow read: if isAdmin() || (isAgent() && ownsExistingRecord());
        allow create: if (isAdmin() || (isAgent() && ownsRecord())) && isScopedWrite();
        allow update: if (isAdmin() || (isAgent() && ownsExistingRecord())) && isScopedWrite();
        allow delete: if isAdmin() || (isAgent() && ownsExistingRecord());
      }

      match /policies/{policyId} {
        allow read: if isAdmin() || (isAgent() && ownsExistingRecord());
        allow create: if (isAdmin() || (isAgent() && ownsRecord())) && isScopedWrite();
        allow update: if (isAdmin() || (isAgent() && ownsExistingRecord())) && isScopedWrite();
        allow delete: if isAdmin() || (isAgent() && ownsExistingRecord());
      }

      match /reminders/{reminderId} {
        allow read: if isAdmin() || (isAgent() && ownsExistingRecord());
        allow create: if (isAdmin() || (isAgent() && ownsRecord())) && isScopedWrite();
        allow update: if (isAdmin() || (isAgent() && ownsExistingRecord())) && isScopedWrite();
        allow delete: if isAdmin() || (isAgent() && ownsExistingRecord());
      }

      match /follow_ups/{followUpId} {
        allow read: if isAdmin() || (isAgent() && ownsExistingRecord());
        allow create: if (isAdmin() || (isAgent() && ownsRecord())) && isScopedWrite();
        allow update: if (isAdmin() || (isAgent() && ownsExistingRecord())) && isScopedWrite();
        allow delete: if isAdmin() || (isAgent() && ownsExistingRecord());
      }
    }
  }
}
